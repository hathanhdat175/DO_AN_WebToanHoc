{
  "name": "goc-tu-giac",
  "version": "1.0.0",
  "private": true,
  "description": "Góc Tứ Giác - ứng dụng hỗ trợ học hình học phẳng (tứ giác) với Node.js, Express và Neo4j",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "jest",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=18.11"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^5.27.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
