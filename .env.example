# Sao chép file này thành ".env" rồi sửa các giá trị bên dưới.

# Cổng chạy website
PORT=3000

# Kết nối Neo4j
#  - Neo4j Desktop / Docker:  bolt://localhost:7687
#  - Neo4j AuraDB (đám mây):  neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Tên database, mặc định là "neo4j"
NEO4J_DATABASE=neo4j

# Chuỗi bí mật để ký token đăng nhập (JWT). Đổi thành một chuỗi dài bất kỳ.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai
